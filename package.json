{
  "name": "sheet-music",
  "version": "0.1.0",
  "description": "Upload sheet music, pick an instrument, and play it back with a metronome and note highlighting",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "check": "node tools/check-musicxml.mjs samples/*.musicxml",
    "test": "node tools/browser-test.mjs",
    "test:audio": "node tools/browser-test.mjs --audio",
    "make-midi": "node tools/make-midi-sample.mjs",
    "test:transcribe": "node --env-file-if-exists=.env tools/transcribe-test.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "express": "^5.3.0",
    "multer": "^2.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
