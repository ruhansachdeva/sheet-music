# Copy to .env and fill in. A key is only needed for reading photos and PDFs -
# MusicXML and MIDI files play without one.

# Google Gemini (has a free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude (paid): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Which one to use. Leave blank to use whichever key is set above.
PROVIDER=

PORT=3000
